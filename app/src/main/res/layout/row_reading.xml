<?xml version="1.0" encoding="utf-8"?>
<!--
  One saved reading on a single line: when it was taken, then the numbers,
  then the two emoji. Widths are weighted rather than fixed and the text
  autosizes down, so the whole row fits any screen without wrapping onto a
  second line or being cut off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/rowWhen"
        android:layout_width="0dp"
        android:layout_weight="38"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#201F1E"
        android:alpha="0.75"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:text="29/08/2026  08:35" />

    <TextView
        android:id="@+id/rowValues"
        android:layout_width="0dp"
        android:layout_weight="42"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textStyle="bold"
        android:textColor="#201F1E"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="19sp"
        android:autoSizeStepGranularity="1sp"
        android:text="130/79  ♥ 87" />

    <TextView
        android:id="@+id/rowState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="19sp"
        android:text="😴" />

    <TextView
        android:id="@+id/rowRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="21sp"
        android:text="👍" />
</LinearLayout>
