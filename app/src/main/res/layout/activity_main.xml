<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!--
          Title carries the version, filled in from the package at runtime so
          it can never drift from the installed build. Margins keep it clear
          of the ⋮ button, and it autosizes so the version never pushes the
          name off a narrow screen.
        -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="BP Tracker"
            android:textColor="#0078D4"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#201F1E"
            android:textStyle="bold"
            android:textSize="26sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResting"
            android:background="@drawable/btn_rounded"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:backgroundTint="#E1E1E1"
            android:stateListAnimator="@null"
            android:text="😴  Resting" />

        <Button
            android:id="@+id/btnExercise"
            android:background="@drawable/btn_rounded"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:backgroundTint="#E1E1E1"
            android:stateListAnimator="@null"
            android:text="🚴  Exercise" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYS"
                android:textColor="#0078D4"
                android:textStyle="bold"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/etSys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="28sp"
                android:importantForAutofill="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIA"
                android:textColor="#0078D4"
                android:textStyle="bold"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/etDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="28sp"
                android:importantForAutofill="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PULSE"
                android:textColor="#0078D4"
                android:textStyle="bold"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/etPulse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="28sp"
                android:imeOptions="actionDone"
                android:importantForAutofill="no" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnScan"
            android:background="@drawable/btn_rounded"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textColor="#201F1E"
            android:backgroundTint="#E1E1E1"
            android:stateListAnimator="@null"
            android:text="📸  Camera" />

        <Button
            android:id="@+id/btnGallery"
            android:background="@drawable/btn_rounded"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:textColor="#201F1E"
            android:backgroundTint="#E1E1E1"
            android:stateListAnimator="@null"
            android:text="🖼️  Gallery" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSave"
        android:background="@drawable/btn_rounded"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0078D4"
        android:stateListAnimator="@null"
        android:text="Save" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#22000000" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="No readings yet.\nType the numbers and tap Save."
        android:textSize="15sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:divider="#22000000"
        android:dividerHeight="1dp" />
</LinearLayout>
